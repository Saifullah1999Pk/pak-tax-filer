{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-python.sh",
            "timeout": 60,
            "statusMessage": "Running pylint..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-frontend.sh",
            "timeout": 60,
            "statusMessage": "Running frontend lint..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-safety.sh",
            "timeout": 10,
            "statusMessage": "Checking git safety..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tax-rates-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking the tax-rates guard..."
          }
        ]
      }
    ]
  }
}
